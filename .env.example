# RisingHub redeem bot — copy to .env and fill in real values locally.
# Committed placeholders only; never commit .env.

# RisingHub
RISINGHUB_BASE_URL=https://example.test/

# Discord selfbot (REST fetch only — personal use; violates Discord ToS)
DISCORD_USER_TOKEN=CHANGE_ME
DISCORD_CHANNEL_IDS=123456789012345678,987654321098765432
DISCORD_FETCH_SINCE=2025-01-01T00:00:00Z

# Discord webhook (fatal errors @everyone; success embeds without ping)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/CHANGE_ME/CHANGE_ME

# Verbose pipeline traces to the same webhook (source message, probe, per-account results)
# Flip off once extraction/redemption accuracy looks good.
DISCORD_WEBHOOK_DEBUG=false
# Required for jump links in debug embeds (server ID, not channel ID)
DISCORD_GUILD_ID=

# Paths
ACCOUNTS_FILE=config/accounts.json
DATA_DIR=data
# SQLITE_PATH=data/state.sqlite
